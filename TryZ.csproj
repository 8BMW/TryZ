<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TryZ</AssemblyName>
    <RootNamespace>TryZ</RootNamespace>
    <ApplicationIcon>assets\tryz.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- SYSLIB0014: System.Net.Mail.SmtpClient is the built-in SMTP client used for optional new-finding e-mail alerts. -->
    <NoWarn>$(NoWarn);WFO1000;SYSLIB0014</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WinForms needs the OS culture (e.g. en-US / 1033) at startup; invariant-globalization mode rejects it and
         crashes before the window shows. All formatting/parsing uses CultureInfo.InvariantCulture explicitly, so
         disabling invariant mode does not change report output. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.9.0</Version>
    <Product>TryZ Security Suite</Product>
    <AssemblyTitle>TryZ Security Suite</AssemblyTitle>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Net.Http" />
    <Using Include="System.Windows.Forms.Timer" Alias="Timer" />
    <EmbeddedResource Include="assets\logo.txt" LogicalName="TryZ.logo.txt" />
    <EmbeddedResource Include="assets\tryz.ico" LogicalName="TryZ.tryz.ico" />
    <EmbeddedResource Include="assets\data\**\*" LogicalName="TryZ.data.%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="dist\**;.review\**;tools\**" />
    <None Remove="dist\**;.review\**;tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-GDI" Version="6.2.3" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
